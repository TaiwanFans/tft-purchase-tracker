+    fun getConversationItems(key: String, limit: Int = 300): List<InboxItem> {
+        val out = mutableListOf<InboxItem>()
+        readableDatabase.rawQuery(
+            "SELECT * FROM inbox WHERE conversation_key=? ORDER BY created_at DESC LIMIT ?",
+            arrayOf(key, limit.toString())
+        ).use { c -> while (c.moveToNext()) out += inboxFrom(c) }
+        return out.reversed()
