+    private fun deriveConversationKey(source: String, groupName: String, sender: String, text: String, createdAt: Long): String {
+        fun norm(v: String) = v.trim().lowercase().replace(Regex("\\s+"), " ")
+        return when {
+            groupName.isNotBlank() -> "group:${norm(groupName)}"
+            source.startsWith("LINE") && sender.isNotBlank() -> "private:${norm(sender)}"
+            else -> "item:${createdAt}:${kotlin.math.abs((source + text).hashCode())}"
+        }
+    }
+
+    private fun deriveConversationType(source: String, groupName: String, sender: String): String = when {
+        source == "LINE TXT" -> "TXT對話"
+        source.startsWith("LINE") && groupName.isNotBlank() -> "LINE群組"
+        source.startsWith("LINE") && sender.isNotBlank() -> "LINE私聊"
+        else -> "其他"
+    }
+
