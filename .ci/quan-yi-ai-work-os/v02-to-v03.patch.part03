+    fun getConversationBundles(limitItems: Int = 2000): List<ConversationBundle> {
+        val items = getInbox(limitItems)
+        val profiles = getConversationProfiles().associateBy { it.key }
+        return items.groupBy { it.conversationKey.ifBlank { "legacy:${it.id}" } }.map { (key, group) ->
+            val sorted = group.sortedByDescending { it.createdAt }
+            val latest = sorted.first()
