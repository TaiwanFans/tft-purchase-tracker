+            conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            val code = conn.responseCode
+            val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+            val response = try { stream?.bufferedReader()?.use { it.readText() }.orEmpty() } catch (_: Exception) { "" }
+            TestResult(code in 200..299, code, response.take(12_000).ifBlank { if (code in 200..299) "OK" else "No response body" })
+        } catch (e: Exception) {
+            TestResult(false, 0, e.message ?: e.javaClass.simpleName)
+        } finally {
+            conn?.disconnect()
+        }
+    }
+}
