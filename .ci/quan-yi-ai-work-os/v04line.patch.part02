+    val status: String,
+    val attempts: Int,
+    val lastError: String,
+    val nextAttemptAt: Long,
+    val createdAt: Long,
+    val updatedAt: Long
+)
+
+data class AgentSyncStats(
+    val pending: Int,
+    val failed: Int,
+    val synced: Int,
+    val lastSyncedAt: Long?
+)
