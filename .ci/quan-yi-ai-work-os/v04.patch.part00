diff -ruN base/app/src/main/java/tw/com/tft/aiworkos/AgentSyncManager.kt target/app/src/main/java/tw/com/tft/aiworkos/AgentSyncManager.kt
--- base/app/src/main/java/tw/com/tft/aiworkos/AgentSyncManager.kt	1970-01-01 00:00:00.000000000 +0000
+++ target/app/src/main/java/tw/com/tft/aiworkos/AgentSyncManager.kt	2026-09-09 04:16:04.720732338 +0000
@@ -0,0 +1,140 @@
+package tw.com.tft.aiworkos
+
+import android.content.Context
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.atomic.AtomicBoolean
+
+object AgentSyncManager {
+    private val running = AtomicBoolean(false)
+
+    data class TestResult(val ok: Boolean, val statusCode: Int, val message: String)
+
+    fun enqueueAndKick(context: Context, inboxId: Long) {
+        if (inboxId <= 0) return
+        WorkOSDatabase(context).use { db -> db.enqueueAgentSync(inboxId) }
+        kick(context)
+    }
+
+    fun kick(context: Context) {
+        val app = context.applicationContext
+        val secure = SecureSettings(app)
+        if (!secure.agentSyncEnabled || secure.agentWebhookUrl.isBlank()) return
+        if (!running.compareAndSet(false, true)) return
+        Thread {
+            try {
+                processQueue(app)
+            } finally {
+                running.set(false)
+            }
+        }.start()
+    }
+
+    fun retryAll(context: Context) {
+        WorkOSDatabase(context).use { it.resetFailedAgentSync() }
+        kick(context)
+    }
+
+    fun testConnection(context: Context, url: String, token: String): TestResult {
+        val payload = JSONObject()
+            .put("schema_version", 1)
+            .put("event_type", "agent_connection_test")
+            .put("source", "quan_yi_ai_work_os")
+            .put("timestamp", System.currentTimeMillis())
+        return postJson(url, token, payload.toString())
+    }
+
+    private fun processQueue(context: Context) {
+        val secure = SecureSettings(context)
+        val url = secure.agentWebhookUrl.trim()
+        if (!secure.agentSyncEnabled || url.isBlank()) return
+        val token = secure.getAgentToken()
+
+        WorkOSDatabase(context).use { db ->
+            var processed = 0
+            while (processed < 50) {
+                val q = db.nextPendingAgentSync() ?: break
+                val inbox = db.getInbox(q.inboxId)
+                if (inbox == null) {
+                    db.markAgentSyncFailed(q.id, "找不到 Inbox #${q.inboxId}", permanent = true)
+                    processed++
+                    continue
+                }
+                val payload = buildPayload(secure, db, inbox)
+                db.markAgentSyncSending(q.id)
+                val result = postJson(url, token, payload.toString())
+                if (result.ok) {
+                    db.markAgentSyncSuccess(q.id, result.message)
+                    db.addAgentEvent(inbox.id, inbox.conversationKey, payload.toString(), result.message)
+                } else {
+                    db.markAgentSyncFailed(q.id, "HTTP ${result.statusCode}: ${result.message}")
+                    // 避免錯誤網址或服務故障時在背景無限緊密重試。
+                    break
+                }
+                processed++
+            }
+        }
+    }
+
+    private fun buildPayload(secure: SecureSettings, db: WorkOSDatabase, item: InboxItem): JSONObject {
+        val profile = db.getConversationProfiles().firstOrNull { it.key == item.conversationKey }
+        val recent = org.json.JSONArray()
+        db.getConversationItems(item.conversationKey, 12).forEach { m ->
+            recent.put(JSONObject()
+                .put("id", m.id)
+                .put("sender", m.sender)
+                .put("text", m.text)
+                .put("timestamp_ms", m.createdAt))
+        }
+        return JSONObject()
+            .put("schema_version", 1)
+            .put("event_type", "line_message")
+            .put("event_id", "inbox-${item.id}")
+            .put("install_id", secure.installId)
+            .put("source", item.source)
+            .put("conversation", JSONObject()
+                .put("id", item.conversationKey)
+                .put("name", item.groupName.ifBlank { item.sender.ifBlank { "LINE 對話" } })
+                .put("type", item.conversationType)
+                .put("known_role", profile?.role ?: "未知")
+                .put("known_company", profile?.company ?: ""))
+            .put("recent_context", recent)
+            .put("sender", JSONObject().put("display_name", item.sender))
+            .put("message", JSONObject()
+                .put("id", item.id)
+                .put("text", item.text)
+                .put("timestamp_ms", item.createdAt)
+                .put("attachment_mime", item.mimeType ?: JSONObject.NULL))
+            .put("agent_instructions", JSONObject()
+                .put("language", "zh-TW")
+                .put("purpose", "持續整合人物、公司、角色、產品、案件、報價、交期、待辦、承諾與下一步，不要把每則訊息各自建立案件")
+                .put("require_evidence", true))
+    }
+
+    private fun postJson(urlString: String, token: String, body: String): TestResult {
+        if (!urlString.startsWith("https://")) return TestResult(false, 0, "Webhook 必須使用 https://")
+        var conn: HttpURLConnection? = null
+        return try {
+            conn = (URL(urlString).openConnection() as HttpURLConnection).apply {
+                requestMethod = "POST"
+                connectTimeout = 12_000
+                readTimeout = 20_000
+                doOutput = true
+                setRequestProperty("Content-Type", "application/json; charset=utf-8")
+                setRequestProperty("Accept", "application/json")
+                setRequestProperty("User-Agent", "QuanYiAIWorkOS/0.4")
+                if (token.isNotBlank()) setRequestProperty("Authorization", "Bearer $token")
+            }
+            conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
+            val code = conn.responseCode
+            val stream = if (code in 200..299) conn.inputStream else conn.errorStream
+            val response = try { stream?.bufferedReader()?.use { it.readText() }.orEmpty() } catch (_: Exception) { "" }
+            TestResult(code in 200..299, code, response.take(12_000).ifBlank { if (code in 200..299) "OK" else "No response body" })
+        } catch (e: Exception) {
+            TestResult(false, 0, e.message ?: e.javaClass.simpleName)
+        } finally {
+            conn?.disconnect()
+        }
+    }
+}
