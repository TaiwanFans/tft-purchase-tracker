            .put("conversation_title", conversationTitle)
+                    .put("sub_text", sub)
+                    .put("text", text)
+                    .put("messaging_style", false)
+                    .put("note", "僅保存 Android 通知實際提供的欄位；不代表 LINE 完整聊天內容")
+                    .toString()
+                db.addInboxDeduplicated(
                     source = "LINE通知",
                     text = text,
-                    groupName = group,
+                    groupName = if (isGroup) displayName else "",
                     sender = sender,
-                    rawPayload = raw
+                    rawPayload = raw,
+                    conversationKey = key,
+                    conversationType = type,
+                    eventFingerprint = fingerprint(key, sender, text, n.postTime),
+                    createdAt = n.postTime
                 )
             }
         } catch (_: Exception) {
-            // 通知監聽不可因資料庫錯誤造成服務崩潰。
+            // 通知監聽不可因解析或資料庫錯誤造成服務崩潰。
         }
     }
+
+    private data class Msg(val text: String, val sender: String, val time: Long)
+
+    private fun extractMessagingStyleMessages(extras: Bundle): List<Msg> {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) return emptyList()
+        val bundles = extras.getParcelableArray(Notification.EXTRA_MESSAGES) ?: return emptyList()
+        return try {
+            Notification.MessagingStyle.Message.getMessagesFromBundleArray(bundles).mapNotNull { m ->
+                val text = m.text?.toString()?.trim().orEmpty()
+                if (text.isBlank()) null else Msg(
+                    text = text,
+                    sender = if (Build.VERSION.SDK_INT >= 28) m.senderPerson?.name?.toString().orEmpty() else @Suppress("DEPRECATION") m.sender?.toString().orEmpty(),
+                    time = m.timestamp
+                )
+            }
+        } catch (_: Exception) { emptyList() }
+    }
+
+    private fun conversationKey(type: String, name: String): String =
+        "${type.lowercase()}:${name.trim().lowercase().replace(Regex("\\s+"), " ")}"
+
+    private fun fingerprint(key: String, sender: String, text: String, time: Long): String {
+        val bucket = time / 120_000L
+        val raw = "$key|${sender.trim()}|${text.trim()}|$bucket"
+        return MessageDigest.getInstance("SHA-256").digest(raw.toByteArray())
+            .joinToString("") { "%02x".format(it) }
+    }
 }
